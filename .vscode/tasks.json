{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "🚀 1. Запуск Сервера Разработки (Next.js Dev: Port 3000)",
      "type": "shell",
      "command": "npm run dev",
      "isBackground": true,
      "problemMatcher": {
        "owner": "nextjs",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*compiling.*",
          "endsPattern": ".*Ready in.*"
        }
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "clear": true
      }
    },
    {
      "label": "📦 2. Сборка Проекта (Next.js Build)",
      "type": "shell",
      "command": "npm run build",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "⚡ 3. Запуск Продакшн Сервера (Next.js Start)",
      "type": "shell",
      "command": "npm start",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "📊 4. Синхронизация Контента (Google Sheets -> content.json)",
      "type": "shell",
      "command": "node scripts/sync-content.js",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "🏛️ 5. Инициализация Структуры CRM Таблиц (Google Sheets)",
      "type": "shell",
      "command": "node scripts/init-google-sheets.js",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "🧹 6. Освободить Порт 3000 (Free Port 3000)",
      "type": "shell",
      "command": "powershell -Command \"Get-NetTCPConnection -LocalPort 3000 -State Listen -ErrorAction SilentlyContinue | ForEach-Object { Stop-Process -Id $_.OwningProcess -Force }\"",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "📱 7. Полный Стартер PowerShell (deploy_and_run.ps1)",
      "type": "shell",
      "command": "powershell -ExecutionPolicy Bypass -File .\\deploy_and_run.ps1",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "🗂️ 8. Миграция Листов Google Таблиц на Русские Названия",
      "type": "shell",
      "command": "npm run migrate-sheets",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    }
  ]
}