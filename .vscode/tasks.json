{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "🚀 1. Запуск Сервера Разработки (Next.js Dev: Port 3000)",
      "type": "shell",
      "command": "npm run dev",
      "isBackground": true,
      "problemMatcher": {
        "owner": "nextjs",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*compiling.*",
          "endsPattern": ".*Ready in.*"
        }
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "clear": true
      }
    },
    {
      "label": "📦 2. Сборка Проекта (Next.js Build)",
      "type": "shell",
      "command": "npm run build",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "⚡ 3. Запуск Продакшн Сервера (Next.js Start)",
      "type": "shell",
      "command": "npm start",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "📊 4. Синхронизация Контента (Google Sheets -> content.json)",
      "type": "shell",
      "command": "node scripts/sync-content.js",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "🏛️ 5. Инициализация Структуры CRM Таблиц (Google Sheets)",
      "type": "shell",
      "command": "node scripts/init-google-sheets.js",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "🧹 6. Освободить Порт 3000 (Free Port 3000)",
      "type": "shell",
      "command": "powershell -Command \"Get-NetTCPConnection -LocalPort 3000 -State Listen -ErrorAction SilentlyContinue | ForEach-Object { Stop-Process -Id $_.OwningProcess -Force }\"",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "📱 7. Полный Стартер PowerShell - deploy_and_run.ps1",
      "type": "shell",
      "command": "pwsh -ExecutionPolicy Bypass -File .\\deploy_and_run.ps1",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "🗂️ 8. Миграция Листов Google Таблиц на Русские Названия",
      "type": "shell",
      "command": "npm run migrate-sheets",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "📥 9. Установка Зависимостей - npm install",
      "type": "shell",
      "command": "npm install",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "⏸️ 10. Перевести сайт в режим обслуживания - Vercel Pause",
      "type": "shell",
      "command": "bash \".\\160519092026 Исторические скрипты запуска корня\\pause-site.sh\"",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "▶️ 11. Возобновить штатную работу сайта - Vercel Resume",
      "type": "shell",
      "command": "bash \".\\160519092026 Исторические скрипты запуска корня\\resume-site.sh\"",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "🧹 12. Очистить архивные дубли и корень рабочей области",
      "type": "shell",
      "command": "pwsh -ExecutionPolicy Bypass -File .\\clean_accumulator_and_root.ps1",
      "options": {
        "cwd": "${workspaceFolder}/../Глобальные настройки проекта (накопитель)"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "📦 13. Пересобрать переносной запускатор - Уровень 3",
      "type": "shell",
      "command": "pwsh -ExecutionPolicy Bypass -File .\\rebuild_portable_launcher.ps1",
      "options": {
        "cwd": "${workspaceFolder}/../Глобальные настройки проекта (накопитель)"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "💾 14. SPARK: Универсальное создание двухуровневого бэкапа и сохранение версии",
      "type": "shell",
      "command": "pwsh -ExecutionPolicy Bypass -File .\\create_project_backup.ps1",
      "options": {
        "cwd": "${workspaceFolder}/../Глобальные настройки проекта (накопитель)"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "clear": true
      }
    },
    {
      "label": "🛠️ 15. SPARK: Восстановить все удаленные листы и контент из эталона",
      "type": "shell",
      "command": "node scripts/restore-sheets.js",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    }
  ]
}