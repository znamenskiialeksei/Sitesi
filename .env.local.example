# ==============================================================================
# КОНФИГУРАЦИЯ СЕРВИСОВ УВЕДОМЛЕНИЙ И ПОЧТЫ : VILLA TURAMAN
# Файл: .env.local.example
# Назначение: Шаблон ключей доступа к почтовым шлюзам и Telegram боту
# ==============================================================================

# 1. ТЕЛЕГРАМ ДУБЛИРОВАНИЕ : Мгновенная отправка кодов и заявок владельцу
# Для создания бота напишите @BotFather в Telegram и скопируйте токен бота
TELEGRAM_BOT_TOKEN=

# Ваш персональный или групповой Chat ID в Telegram : узнать можно через @userinfobot
TELEGRAM_CHAT_ID=

# 2. GOOGLE APPS SCRIPT GMAIL RELAY : Бесплатная отправка через Gmail виллы
# В Google Таблице откройте: Расширения -> Apps Script -> Развернуть -> Новое развертывание
# Выберите тип: Веб-приложение, Доступ: Все. Скопируйте полученный URL сюда:
GOOGLE_APPS_SCRIPT_URL=

# 3. ДОПОЛНИТЕЛЬНЫЕ ВНЕШНИЕ ПОЧТОВЫЕ ШЛЮЗЫ
# Resend API : бесплатно 3000 писем в месяц https://resend.com
RESEND_API_KEY=

# Brevo API : Sendinblue : бесплатно 300 писем в день https://brevo.com
BREVO_API_KEY=

# Email отправителя по умолчанию
MAIL_FROM=Villa Turaman <booking@villaturaman.com>

# 4. БАНКОВСКИЙ ЭКВАЙРИНГ И ПЛАТЕЖНЫЕ СИСТЕМЫ
# Stripe : Международные банковские карты EUR и USD
STRIPE_SECRET_KEY=

# Т-Банк : Эквайринг банковских карт РФ и СБП
TBANK_TERMINAL_KEY=
TBANK_SECRET_KEY=

# ЮKassa : Платежный шлюз РФ
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# PayPal : Международная система платежей
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Iyzico : Турецкий банковский эквайринг TRY
IYZICO_API_KEY=
IYZICO_SECRET_KEY=

